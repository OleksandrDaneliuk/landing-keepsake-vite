//- src/components/sections/services.pug
+section-block({
  id: "about",
  mod: "services",
  title: "What do we do",
  desc: "We are a small team of designers and makers who help brands look their best online and offline.",
})
  .services-grid
    each service in services
      article.service-card
        .service-card__icon
          +icon(service.icon, service.iconSize)
        h3.service-card__title #{ service.title }
        p.service-card__text #{ service.text }
