//- src/mixins/icon.pug
//- +icon(name, size)  ->  <svg><use href="#icon-name"></svg> from the sprite.
//- `case` picks the intrinsic size per icon; `size` (optional) scales by width.
mixin icon(name, size)
  - let w = 16, h = 16
  case name
    when 'heart'
      - w = 16; h = 14.4
    when 'plus'
      - w = 16; h = 16
    when 'mail'
      - w = 14; h = 10
    when 'chevron'
      - w = 5; h = 9
    when 'burger'
      - w = 22; h = 16
    when 'close'
      - w = 22; h = 22
    when 'arrow-up'
      - w = 12; h = 14
    when 'monitor'
      - w = 42; h = 30
    when 'video'
      - w = 40; h = 32
    when 'print'
      - w = 42; h = 34
    default
      - w = 16; h = 16
  - const width = size || w
  - const height = Math.round((width * h) / w * 10) / 10
  svg.icon(class=`icon--${name}` width=width height=height aria-hidden="true" focusable="false")&attributes(attributes)
    use(href=`#icon-${name}`)
